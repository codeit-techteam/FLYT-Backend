# Application
NODE_ENV=development
PORT=5050
API_BASE_URL=http://localhost:5050
LOG_LEVEL=info

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://flyt:flyt_secret@localhost:5432/flyt_db?schema=public
DIRECT_URL=postgresql://flyt:flyt_secret@localhost:5432/flyt_db?schema=public

# Redis
REDIS_URL=redis://:flyt_redis_secret@localhost:6380
REDIS_PASSWORD=flyt_redis_secret
REDIS_PORT=6380

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# OTP
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
# development | msg91
OTP_PROVIDER=development

# MSG91 (required when OTP_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# Google Maps
GOOGLE_MAPS_API_KEY=
# development | google
MAPS_PROVIDER=development

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# development | razorpay
PAYMENT_PROVIDER=development

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# development | firebase
PUSH_PROVIDER=development

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=flyt-private
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
# development | r2
STORAGE_PROVIDER=development

# Matching / Dispatch
MATCHING_RADIUS_METERS=5000
MATCHING_WEIGHT_ETA=0.40
MATCHING_WEIGHT_DISTANCE=0.20
MATCHING_WEIGHT_ELIGIBILITY=0.15
MATCHING_WEIGHT_AVAILABILITY=0.15
MATCHING_WEIGHT_QUALITY=0.10
DISPATCH_OFFER_TIMEOUT_SECONDS=30
DISPATCH_MAX_RETRIES=5
LOCATION_STALE_SECONDS=60

# Pricing
SILVER_DISCOUNT_PERCENT=10
DEFAULT_COMMISSION_PERCENT=20

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
OTP_RATE_LIMIT_MAX=5

# Socket
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=20000
